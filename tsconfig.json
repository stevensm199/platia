{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@prisma/client": ["./node_modules/.prisma/client/index.d.ts"]
    }
  },
  "include": ["src", "prisma", "test", "vitest.config.ts"]
}
